# Copy to .env locally; on Render set these in Dashboard > Environment.
# NEVER commit the real .env file.

PORT=8000
NODE_ENV=production

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/serverfy?retryWrites=true&w=majority
MONGODB_DB=serverfy

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080,https://your-site.lovable.app

# Shared secret required by admin endpoints (GET /api/server-requests)
ADMIN_API_KEY=change-me-to-a-long-random-string
